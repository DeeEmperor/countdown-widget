<?xml version="1.0" encoding="utf-8"?>
<!--
  exam_countdown_widget_info.xml
  ─────────────────────────────────────────────
  AppWidget provider metadata used by the Android launcher.

  minWidth / minHeight:
    Use the formula: cells × 74 dp − 2 dp
      4 cells wide → 4 × 74 − 2 = 294 dp
      2 cells tall → 2 × 74 − 2 = 146 dp

  updatePeriodMillis:
    Android enforces a minimum of 1 800 000 ms (30 min).
    Our WorkManager job handles 15-minute refreshes independently.

  initialLayout:
    Points to the placeholder XML generated by the library
    (android/app/src/main/res/layout/rn_widget.xml is auto-created).
-->
<appwidget-provider
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/rn_widget"
    android:widgetCategory="home_screen"
    android:resizeMode="horizontal|vertical"
    android:description="@string/app_name" />
